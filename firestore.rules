rules_version = '2';

/**
 * FEROX Firestore rules.
 *
 * The web API key in web/assets/js/core/config.js is public and authorises
 * nothing. This file is the entire access control story, so it is written to
 * be read: one collection, one owner, no exceptions and no admin back door.
 *
 * Test a change before deploying it:
 *   firebase emulators:exec --only firestore "npm test"
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /** A field is absent, or a string no longer than `max`. */
    function str(field, max) {
      return !(field in request.resource.data)
          || (request.resource.data[field] is string
              && request.resource.data[field].size() <= max);
    }

    /** A field is absent, or a number between zero and `max`. */
    function count(field, max) {
      return !(field in request.resource.data)
          || (request.resource.data[field] is int
              && request.resource.data[field] >= 0
              && request.resource.data[field] <= max);
    }


    /**
     * An athlete's whole log, one document, keyed by their Firebase uid.
     *
     * `request.auth.uid == uid` is doing all the work: a signed-in person can
     * reach their own document and there is no query that returns anyone
     * else's, because the only path to a document is through its owner's uid.
     */
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Writes carry two cheap shape checks on top of ownership. Neither is
      // a security boundary — the owner may already write anything they like
      // to their own log — they just stop a malformed or runaway document
      // from being stored at all, so the client never reads back something it
      // cannot migrate. Rules cannot measure a document's size in bytes; the
      // 1 MiB ceiling is enforced client-side in FirestoreAdapter.save, where
      // it can fail with a sentence instead of INVALID_ARGUMENT.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.version is int
                   && request.resource.data.keys().size() < 60;

      // The log is one document. Nothing nests under it, and saying so stops
      // a future subcollection from inheriting these rules by accident.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    /**
     * The public face of an athlete: a handle, a nickname, a picture and the
     * handful of numbers they are happy for other people to see.
     *
     * Readable by anyone signed in — that is the point of it — and writable
     * only by its owner. What keeps this safe is not the rule, it is the
     * allow-list in `PUBLIC_FIELDS` in core/social.js: the private log stays
     * in `users/{uid}` and nothing copies a field here unless it is named
     * there. Bodyweight, measurements, meals and notes are not.
     *
     * The size cap is the only thing standing between this and somebody using
     * their public profile as free hosting.
     */
    match /profiles/{uid} {
      allow read: if request.auth != null;

      /*
       * Every field is bounded. A public document is the one place another
       * person's bytes end up on your screen, so the rules cap what can be
       * stored rather than trusting the client that wrote it — a client the
       * author controls completely.
       *
       * The picture cap matters most: without it a profile can carry a
       * megabyte `data:` URL that every viewer downloads, which is free
       * bandwidth for them and a bill for us.
       */
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().size() <= 18
                   && str('nickname', 40)
                   && str('handle', 20)
                   && str('picture', 500)
                   && str('goal', 20)
                   && str('band', 8)
                   && str('region', 16)
                   && str('joined', 10)
                   && count('streak', 100000)
                   && count('sessions', 1000000)
                   && count('volume', 10000000000)
                   && count('medals', 1000);
    }

    /**
     * Handle ownership, and the search index.
     *
     * The handle is the document id, which is what makes it unique — Firestore
     * has no unique constraint, and this is the only way to get one that two
     * simultaneous writers cannot both win.
     *
     * `create` requires the document not to exist, which Firestore enforces
     * for `create` specifically rather than `write`, so splitting the two
     * verbs here is load-bearing: with a single `write` rule, claiming a
     * handle somebody already owns would be an update and would succeed.
     *
     * An owner may update their own row (a new nickname or picture) and
     * delete it when changing handle. Nobody can touch anyone else's.
     */
    match /handles/{handle} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'nickname', 'picture'])
                    && handle.size() >= 3 && handle.size() <= 20
                    && handle.matches('^[a-z0-9_]+$');

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Anything not named above is closed. This is the default, but a reader
    // should not have to know that to be sure of it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
