# FEROX server configuration.
# The web app in web/ runs without any of this — see docs/google-oauth-setup.md.

# Same client id the browser uses (web/assets/js/core/config.js).
# Not a secret; leave empty to run the API in guest-only mode.
GOOGLE_CLIENT_ID=

# Signs FEROX session tokens. Use a long random value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production while this is the default.
JWT_SECRET=ferox-dev-secret-change-me
JWT_TTL=30d

PORT=4000

# Where athlete logs are written (one JSON file per user).
FEROX_DATA_DIR=.data

# Comma-separated allowed origins, or * during development.
# For GitHub Pages:  CORS_ORIGIN=https://victordeglon.github.io
CORS_ORIGIN=*
